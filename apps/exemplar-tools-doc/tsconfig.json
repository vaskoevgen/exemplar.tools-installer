{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "shared_ui": ["src/shared_ui/index.ts"],
      "page_content": ["src/page_content/index.ts"],
      "pipeline_diagram": ["src/pipeline_diagram/index.ts"],
      "routing_and_layout": ["src/routing_and_layout/index.ts"],
      "project_scaffold": ["src/project_scaffold/index.ts"],
      "root": ["src/root/index.ts"]
    }
  },
  "include": ["src"]
}
